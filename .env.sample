# --- Database ---
# Local dev (docker-compose): matches the db service below.
# Production (Render): set this in the Render dashboard to your Neon pooled connection string.
DATABASE_URL=postgres://queueforge:queueforge@db:5432/queueforge

# --- App ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Worker pool ---
WORKER_CONCURRENCY=4
POLL_INTERVAL_MS=5000
JOB_MAX_ATTEMPTS_DEFAULT=5
RETRY_BASE_DELAY_SECONDS=10
RETRY_MAX_DELAY_SECONDS=3600
SHUTDOWN_DRAIN_TIMEOUT_MS=25000

# --- Scheduler (recurring jobs) ---
SCHEDULER_TICK_MS=30000

# --- Public API protection ---
ENQUEUE_RATE_LIMIT_PER_MIN=60

# --- Dashboard auth (optional) ---
# Unset = fully open (local dev default). When set, state-changing routes
# (enqueue, cancel, DLQ replay, schedules) require `Authorization: Bearer <token>`.
# Set this in the Render dashboard as a secret env var for the public demo.
#DASHBOARD_TOKEN=change-me
